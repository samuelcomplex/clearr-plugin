root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props}]
indent_size = 2

[*.cs]
# Logging happens a handful of times per cleanup; LoggerMessage source generators would add noise for no gain.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# Clearr is only consumed from C#; VB keyword clashes (IKeepStore.Set) don't matter.
dotnet_diagnostic.CA1716.severity = none
# The public types are app internals, not a library API.
dotnet_diagnostic.CA1515.severity = none
csharp_style_namespace_declarations = file_scoped:warning
