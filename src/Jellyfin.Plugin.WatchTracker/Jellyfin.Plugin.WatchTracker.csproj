<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Normal build (your PC / CI):   dotnet build -c Release
      -> references the official Jellyfin.Controller 10.11 NuGet package, targets net9.0.
    Offline build (no NuGet access): dotnet build -c Release -p:UseStubs=true
      -> references signature-identical stubs in ../../stubs, targets net8.0
         (net8 assemblies load fine in Jellyfin's net9 runtime).
  -->

  <PropertyGroup>
    <TargetFramework Condition="'$(UseStubs)' != 'true'">net9.0</TargetFramework>
    <TargetFramework Condition="'$(UseStubs)' == 'true'">net8.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.WatchTracker</RootNamespace>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseStubs)' != 'true'">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseStubs)' == 'true'">
    <ProjectReference Include="../../stubs/MediaBrowser.Controller/MediaBrowser.Controller.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
