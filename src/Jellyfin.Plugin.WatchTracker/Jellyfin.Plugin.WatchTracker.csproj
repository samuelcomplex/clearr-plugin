<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Normal build (your PC / CI):   dotnet build -c Release
      -> references the official Jellyfin.Controller 12.x NuGet package, targets net10.0.
    Offline build (no NuGet access): dotnet build -c Release -p:UseStubs=true
      -> references signature-identical stubs in ../../stubs, targets net8.0
         (net8 assemblies load fine in Jellyfin 12.x on .NET 10).
  -->

  <PropertyGroup>
    <!-- Override from the command line, e.g. -p:JellyfinVersion=10.11.* -p:JellyfinTargetFramework=net9.0 -->
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.4.0</JellyfinVersion>
    <JellyfinTargetFramework Condition="'$(JellyfinTargetFramework)' == ''">net10.0</JellyfinTargetFramework>
    <TargetFramework Condition="'$(UseStubs)' != 'true'">$(JellyfinTargetFramework)</TargetFramework>
    <TargetFramework Condition="'$(UseStubs)' == 'true'">net8.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.WatchTracker</RootNamespace>
    <AssemblyVersion>1.2.2.0</AssemblyVersion>
    <FileVersion>1.2.2.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseStubs)' != 'true'">
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseStubs)' == 'true'">
    <ProjectReference Include="../../stubs/MediaBrowser.Controller/MediaBrowser.Controller.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
